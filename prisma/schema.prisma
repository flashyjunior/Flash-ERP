generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "sqlserver"
  relationMode = "prisma"
}

model RetailOrg {
  id                                String                             @id @default(uuid())
  code                              String                             @unique
  name                              String
  baseCurrencyCode                  String
  timezone                          String
  stockUpdateMode                   String                             @default("AUTO")
  companySettingsJson               String?                            @db.NVarChar(Max)
  ldapSettingsJson                  String?                            @db.NVarChar(Max)
  smtpSettingsJson                  String?                            @db.NVarChar(Max)
  smsSettingsJson                   String?                            @db.NVarChar(Max)
  optionsSettingsJson               String?                            @db.NVarChar(Max)
  passwordPolicyJson                String?                            @db.NVarChar(Max)
  loyaltyProgramEnabled             Boolean                            @default(true)
  loyaltyPointsPerCurrencyUnit      Decimal                            @default(1) @db.Decimal(12, 4)
  loyaltyRedemptionEnabled          Boolean                            @default(false)
  loyaltyRedemptionPointsStep       Int                                @default(100)
  loyaltyRedemptionValueAmount      Decimal                            @default(1) @db.Decimal(12, 2)
  loyaltyMinimumRedeemPoints        Int                                @default(100)
  loyaltyMaximumRedeemPercentOfSale Decimal                            @default(100) @db.Decimal(5, 2)
  status                            String                             @default("ACTIVE")
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
  stores                            Store[]
  warehouses                        Warehouse[]
  terminals                         Terminal[]
  syncNodes                         SyncNode[]
  users                             RetailUser[]
  retailUserSessions                RetailUserSession[]
  roles                             Role[]
  customers                         Customer[]
  ecommerceCustomerAccounts         EcommerceCustomerAccount[]
  ecommerceCustomerIdentities       EcommerceCustomerIdentity[]
  ecommerceCustomerSessions         EcommerceCustomerSession[]
  ecommerceOtpChallenges            EcommerceOtpChallenge[]
  ecommerceOrders                   EcommerceOrder[]
  ecommerceFulfillmentLocations     EcommerceFulfillmentLocation[]
  ecommerceFulfillments             EcommerceFulfillment[]
  ecommercePaymentMethods           EcommerceStorePaymentMethod[]
  ecommerceProductReviews           EcommerceProductReview[]
  customerAccountEntries            CustomerAccountEntry[]
  customerAccountPaymentAllocations CustomerAccountPaymentAllocation[]
  suppliers                         Supplier[]
  taxProfiles                       TaxProfile[]
  tenderMethods                     TenderMethod[]
  unitOfMeasures                    UnitOfMeasure[]
  unitOfMeasureSchedules            UnitOfMeasureSchedule[]
  giftCertificates                  GiftCertificate[]
  receiptTemplates                  ReceiptTemplate[]
  banks                             Bank[]
  bankBranches                      BankBranch[]
  bankAccounts                      BankAccount[]
  promotions                        PromotionCampaign[]
  fuelTanks                         ErpFuelTank[]
  fuelPumps                         ErpFuelPump[]
  fuelNozzles                       ErpFuelNozzle[]
  fuelTankDips                      ErpFuelTankDip[]
  fuelMeterReadings                 ErpFuelMeterReading[]
  fuelDeliveries                    ErpFuelDelivery[]
  fuelDeliveryLines                 ErpFuelDeliveryLine[]
  fuelStations                      ErpFuelStation[]
  fuelStationDeliveries             ErpFuelStationDelivery[]
  fuelStationDeliveryLines          ErpFuelStationDeliveryLine[]
  fuelSales                         ErpFuelSale[]
  fuelSaleLines                     ErpFuelSaleLine[]
  fuelSalePayments                  ErpFuelSalePayment[]
  fuelDailyReconciliations          ErpFuelDailyReconciliation[]
  fuelReconciliationLines           ErpFuelReconciliationLine[]
  productDepartments                ProductDepartment[]
  productCategories                 ProductCategory[]
  inventoryCatalogs                 InventoryCatalog[]
  inventoryCatalogProducts          InventoryCatalogProduct[]
  inventoryCatalogStores            InventoryCatalogStore[]
  products                          Product[]
  productAttributeDefinitions       ProductAttributeDefinition[]
  productMatrixVariants             ProductMatrixVariant[]
  priceLists                        PriceList[]
  storeProductPrices                StoreProductPrice[]
  storeProductSellingUnits          StoreProductSellingUnit[]
  inventoryLocations                InventoryLocation[]
  inventoryLedgerEntries            InventoryLedgerEntry[]
  inventorySerialUnits              InventorySerialUnit[]
  inventoryBatches                  InventoryBatch[]
  purchaseOrders                    PurchaseOrder[]
  supplierClaims                    SupplierClaim[]
  supplierReturns                   SupplierReturn[]
  stockCountSessions                StockCountSession[]
  interStoreTransfers               InterStoreTransfer[]
  goodsReceipts                     GoodsReceipt[]
  posShifts                         PosShift[]
  posTransactions                   PosTransaction[]
  salesOrders                       SalesOrder[]
  eodReconciliations                EodReconciliation[]
  bankingDeposits                   BankingDeposit[]
  erpCompanies                      ErpCompany[]
  erpCurrencies                     ErpCurrency[]
  erpFiscalYears                    ErpFiscalYear[]
  erpFiscalPeriods                  ErpFiscalPeriod[]
  erpAccountingSettings             ErpAccountingSettings[]
  erpFuelOperationsSettings         ErpFuelOperationsSettings[]
  glJournalBatches                  GlJournalBatch[]
  glAccounts                        GlAccount[]
  glJournalEntries                  GlJournalEntry[]
  operatingExpenses                 OperatingExpense[]
  erpProductProfiles                ErpProductProfile[]
  erpOperatingSites                 ErpOperatingSite[]
  erpStorageUnits                   ErpStorageUnit[]
  erpArApPostingProfiles            ErpArApPostingProfile[]
  erpPartyAccountingProfiles        ErpPartyAccountingProfile[]
  erpDocumentSequences              ErpDocumentSequence[]
  erpOperationalDocuments           ErpOperationalDocument[]
  erpOperationalDocumentLines       ErpOperationalDocumentLine[]
  erpSettlementAllocations          ErpSettlementAllocation[]
  erpCashbookAccounts               ErpCashbookAccount[]
  erpCashbookEntries                ErpCashbookEntry[]
  erpBankStatements                 ErpBankStatement[]
  erpBankStatementLines             ErpBankStatementLine[]
  erpBankReconciliationMatches      ErpBankReconciliationMatch[]
  erpTaxRegistrations               ErpTaxRegistration[]
  erpTaxCodes                       ErpTaxCode[]
  erpTaxGroups                      ErpTaxGroup[]
  erpTaxGroupLines                  ErpTaxGroupLine[]
  erpTaxTransactions                ErpTaxTransaction[]
  erpFixedAssetClasses              ErpFixedAssetClass[]
  erpFixedAssets                    ErpFixedAsset[]
  erpFixedAssetBooks                ErpFixedAssetBook[]
  erpFixedAssetTransactions         ErpFixedAssetTransaction[]
  erpFinanceDimensions              ErpFinanceDimension[]
  erpHrDepartments                  ErpHrDepartment[]
  erpHrPositions                    ErpHrPosition[]
  erpEmployeeCategories             ErpEmployeeCategory[]
  erpEmployees                      ErpEmployee[]
  erpEmployeePayrollProfiles        ErpEmployeePayrollProfile[]
  erpEmployeePayItems               ErpEmployeePayItem[]
  erpEmployeeAttendance             ErpEmployeeAttendance[]
  erpAttendanceChangeLogs           ErpAttendanceChangeLog[]
  erpLeaveTypes                     ErpLeaveType[]
  erpEmployeeLeaveEntitlements      ErpEmployeeLeaveEntitlement[]
  erpLeaveRequests                  ErpLeaveRequest[]
  erpHrDocuments                    ErpHrDocument[]
  erpEmployeeExits                  ErpEmployeeExit[]
  erpVisitorVisits                  ErpVisitorVisit[]
  erpVisitorStatusLogs              ErpVisitorStatusLog[]
  erpBudgetVersions                 ErpBudgetVersion[]
  erpBudgetLines                    ErpBudgetLine[]
  erpBudgetPeriodAmounts            ErpBudgetPeriodAmount[]
  erpPayrollGlMappings              ErpPayrollGlMapping[]
  erpPayrollPostingBatches          ErpPayrollPostingBatch[]
  erpPayrollPostingLines            ErpPayrollPostingLine[]
  erpPayrollStatutoryRuleSets       ErpPayrollStatutoryRuleSet[]
  erpPayrollTaxBands                ErpPayrollTaxBand[]
  erpPayrollRuns                    ErpPayrollRun[]
  erpPayrollRunEmployees            ErpPayrollRunEmployee[]
  erpPayrollRunLines                ErpPayrollRunLine[]
  erpPayrollFilings                 ErpPayrollFiling[]
  erpBenefitPlans                   ErpBenefitPlan[]
  erpEmployeeBenefitEnrollments     ErpEmployeeBenefitEnrollment[]
  erpEmployeeLoans                  ErpEmployeeLoan[]
  erpEmployeeLoanRepayments         ErpEmployeeLoanRepayment[]
  erpExpenseClaims                  ErpExpenseClaim[]
  erpExpenseClaimLines              ErpExpenseClaimLine[]
  erpTravelRequests                 ErpTravelRequest[]
  erpTravelExpenseLines             ErpTravelExpenseLine[]
  erpRecurringJournalTemplates      ErpRecurringJournalTemplate[]
  erpRecurringJournalTemplateLines  ErpRecurringJournalTemplateLine[]
  transactionReferenceCaptures      TransactionReferenceCapture[]
  securityLogs                      SecurityLog[]
  licenseEvents                     LicenseEvent[]
}

model TransactionReferenceCapture {
  id                  String    @id @default(uuid())
  retailOrgId         String
  referenceValue      String
  normalizedReference String
  phoneNumber         String?
  source              String
  sourceTransactionNo String?
  customerName        String?
  notes               String?   @db.NVarChar(Max)
  firstCapturedAt     DateTime  @default(now())
  lastCapturedAt      DateTime  @updatedAt
  retailOrg           RetailOrg @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)

  @@unique([retailOrgId, normalizedReference])
  @@map("transaction_reference_capture")
}

model ReceiptTemplate {
  id            String    @id @default(uuid())
  retailOrgId   String
  code          String
  name          String
  description   String?
  templateHtml  String    @db.NVarChar(Max)
  isDefault     Boolean   @default(false)
  paperWidthMm  Int       @default(80)
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  retailOrg     RetailOrg @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  salesStores   Store[]   @relation("StoreSalesReceiptTemplate")
  accountStores Store[]   @relation("StoreAccountPaymentReceiptTemplate")

  @@unique([retailOrgId, code])
}

model Bank {
  id                     String       @id @default(uuid())
  retailOrgId            String
  code                   String
  name                   String
  description            String?
  status                 String       @default("ACTIVE")
  originNodeCode         String?
  lastModifiedByNodeCode String?
  recordVersion          Int          @default(1)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?
  retailOrg              RetailOrg    @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  branches               BankBranch[]

  @@unique([retailOrgId, code])
}

model BankBranch {
  id                     String       @id @default(uuid())
  retailOrgId            String
  bankId                 String
  code                   String
  name                   String
  addressLine1           String?
  status                 String       @default("ACTIVE")
  originNodeCode         String?
  lastModifiedByNodeCode String?
  recordVersion          Int          @default(1)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?
  retailOrg              RetailOrg    @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  bank                   Bank         @relation(fields: [bankId], references: [id], onDelete: Cascade)
  account                BankAccount?

  @@unique([retailOrgId, code])
  @@index([bankId, status])
}

model BankAccount {
  id                     String                 @id @default(uuid())
  retailOrgId            String
  branchId               String                 @unique
  accountNumber          String
  accountName            String
  currencyCode           String
  status                 String                 @default("ACTIVE")
  originNodeCode         String?
  lastModifiedByNodeCode String?
  recordVersion          Int                    @default(1)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?
  retailOrg              RetailOrg              @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  branch                 BankBranch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  posPayments            PosPayment[]
  bankingDeposits        BankingDeposit[]
  customerAccountEntries CustomerAccountEntry[]
  erpCashbookAccounts    ErpCashbookAccount[]

  @@unique([retailOrgId, accountNumber])
  @@index([retailOrgId, status])
}

model Store {
  id                                String                        @id @default(uuid())
  retailOrgId                       String
  code                              String
  name                              String
  shortName                         String?
  timezone                          String
  currencyCode                      String
  salesEnabled                      Boolean                       @default(true)
  warehouseEnabled                  Boolean                       @default(true)
  phone                             String?
  email                             String?
  managerName                       String?
  location                          String?
  addressLine1                      String?
  addressLine2                      String?
  city                              String?
  region                            String?
  storeGroupCode                    String?
  storeGroupName                    String?
  storeGroupType                    String?
  stockUpdateMode                   String?
  countryCode                       String?
  postalCode                        String?
  taxRegistrationNo                 String?
  receiptHeader                     String?
  receiptFooter                     String?
  salesReceiptTemplateId            String?
  salesReceiptTemplateHtml          String?                       @db.NVarChar(Max)
  accountPaymentReceiptTemplateId   String?
  accountPaymentReceiptTemplateHtml String?                       @db.NVarChar(Max)
  licenseStatus                     String                        @default("UNLICENSED")
  licenseKey                        String?
  licensedUntil                     DateTime?
  catalogPolicyJson                 String?                       @db.NVarChar(Max)
  storeMode                         String                        @default("OFFLINE_FIRST")
  touchModeEnabled                  Boolean                       @default(true)
  ecommerceEnabled                  Boolean                       @default(false)
  ecommerceSlug                     String?
  ecommerceDisplayName              String?
  ecommerceDescription              String?                       @db.NVarChar(Max)
  ecommerceSupportPhone             String?
  ecommerceSupportEmail             String?
  ecommerceHeroImageUrl             String?
  ecommerceHeroSlidesJson           String?                       @db.NVarChar(Max)
  ecommerceWhatsappPhone            String?
  ecommerceAllowPickup              Boolean                       @default(true)
  ecommerceAllowDelivery            Boolean                       @default(true)
  ecommercePayOnDeliveryEnabled     Boolean                       @default(true)
  ecommerceLayawayEnabled           Boolean                       @default(false)
  ecommerceDeliveryFee              Decimal                       @default(0) @db.Decimal(18, 2)
  ecommerceFreeDeliveryThreshold    Decimal?                      @db.Decimal(18, 2)
  status                            String                        @default("ACTIVE")
  openedOn                          DateTime?
  createdAt                         DateTime                      @default(now())
  updatedAt                         DateTime                      @updatedAt
  retailOrg                         RetailOrg                     @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  salesReceiptTemplate              ReceiptTemplate?              @relation("StoreSalesReceiptTemplate", fields: [salesReceiptTemplateId], references: [id], onDelete: SetNull)
  accountPaymentReceiptTemplate     ReceiptTemplate?              @relation("StoreAccountPaymentReceiptTemplate", fields: [accountPaymentReceiptTemplateId], references: [id], onDelete: SetNull)
  warehouses                        Warehouse[]
  terminals                         Terminal[]
  syncNodes                         SyncNode[]
  homeUsers                         RetailUser[]
  customers                         Customer[]
  customerAccountEntries            CustomerAccountEntry[]
  inventoryLocations                InventoryLocation[]
  inventoryLedgerEntries            InventoryLedgerEntry[]
  inventorySerialUnits              InventorySerialUnit[]
  inventoryBatches                  InventoryBatch[]
  purchaseOrders                    PurchaseOrder[]
  supplierClaims                    SupplierClaim[]
  supplierReturns                   SupplierReturn[]
  stockCountSessions                StockCountSession[]
  outboundInterStoreTransfers       InterStoreTransfer[]          @relation("InterStoreTransferSourceStore")
  inboundInterStoreTransfers        InterStoreTransfer[]          @relation("InterStoreTransferDestinationStore")
  fuelStations                      ErpFuelStation[]              @relation("FuelStationStore")
  goodsReceipts                     GoodsReceipt[]
  posShifts                         PosShift[]
  posTransactions                   PosTransaction[]
  salesOrders                       SalesOrder[]
  eodReconciliations                EodReconciliation[]
  bankingDeposits                   BankingDeposit[]
  glJournalLines                    GlJournalLine[]
  operatingExpenses                 OperatingExpense[]
  giftCertificates                  GiftCertificate[]
  hrEmployees                       ErpEmployee[]
  hrAttendance                      ErpEmployeeAttendance[]
  inventoryCatalogLinks             InventoryCatalogStore[]
  storeProductPrices                StoreProductPrice[]
  storeProductSellingUnits          StoreProductSellingUnit[]
  ecommerceOrders                   EcommerceOrder[]
  ecommerceStorefrontOrders         EcommerceOrder[]              @relation("EcommerceStorefront")
  ecommerceFulfillmentLocations     EcommerceFulfillmentLocation[] @relation("EcommerceFulfillmentStore")
  ecommerceStorefrontFulfillmentLocations EcommerceFulfillmentLocation[] @relation("EcommerceStorefrontFulfillmentLocation")
  ecommerceFulfillments             EcommerceFulfillment[]
  ecommercePaymentMethods           EcommerceStorePaymentMethod[]
  licenseEvents                     LicenseEvent[]

  @@unique([retailOrgId, code])
  @@index([ecommerceSlug])
  @@index([retailOrgId, storeGroupCode])
  @@index([retailOrgId, licenseStatus])
  @@index([retailOrgId, storeMode])
  @@index([salesReceiptTemplateId])
  @@index([accountPaymentReceiptTemplateId])
}

model GlAccount {
  id                            String                            @id @default(uuid())
  retailOrgId                   String
  companyId                     String?
  code                          String
  name                          String
  accountType                   String
  normalBalance                 String
  accountGroup                  String?
  isControlAccount              Boolean                           @default(false)
  allowManualPosting            Boolean                           @default(true)
  sortOrder                     Int                               @default(0)
  externalCode                  String?
  description                   String?
  status                        String                            @default("ACTIVE")
  createdAt                     DateTime                          @default(now())
  updatedAt                     DateTime                          @updatedAt
  retailOrg                     RetailOrg                         @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  company                       ErpCompany?                       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journalLines                  GlJournalLine[]
  cashbookAccounts              ErpCashbookAccount[]
  budgetLines                   ErpBudgetLine[]
  budgetPeriodAmounts           ErpBudgetPeriodAmount[]
  payrollGlMappings             ErpPayrollGlMapping[]
  payrollPostingLines           ErpPayrollPostingLine[]
  recurringJournalTemplateLines ErpRecurringJournalTemplateLine[]

  @@unique([retailOrgId, code])
  @@index([companyId])
  @@index([retailOrgId, accountType, status])
}

model GlJournalBatch {
  id          String           @id @default(uuid())
  retailOrgId String
  companyId   String?
  batchNo     String
  sourceType  String           @default("MANUAL")
  postingDate DateTime
  description String
  status      String           @default("DRAFT")
  totalDebit  Decimal          @default(0) @db.Decimal(18, 2)
  totalCredit Decimal          @default(0) @db.Decimal(18, 2)
  postedAt    DateTime?
  reversedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  retailOrg   RetailOrg        @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  company     ErpCompany?      @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entries     GlJournalEntry[]

  @@unique([retailOrgId, batchNo])
  @@index([retailOrgId, status, postingDate])
  @@index([companyId, status])
}

model GlJournalEntry {
  id                       String                     @id @default(uuid())
  retailOrgId              String
  companyId                String?
  journalBatchId           String?
  fiscalPeriodId           String?
  journalNo                String
  journalType              String                     @default("GENERAL")
  sourceType               String
  sourceId                 String
  sourceReference          String?
  reversalOfJournalEntryId String?
  postingDate              DateTime
  description              String
  status                   String                     @default("POSTED")
  postedBy                 String?
  reversalReason           String?
  postedAt                 DateTime                   @default(now())
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  retailOrg                RetailOrg                  @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  company                  ErpCompany?                @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journalBatch             GlJournalBatch?            @relation(fields: [journalBatchId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  fiscalPeriod             ErpFiscalPeriod?           @relation(fields: [fiscalPeriodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversalOfJournalEntry   GlJournalEntry?            @relation("GlJournalEntryReversal", fields: [reversalOfJournalEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversalEntries          GlJournalEntry[]           @relation("GlJournalEntryReversal")
  lines                    GlJournalLine[]
  operationalDocuments     ErpOperationalDocument[]
  settlementAllocations    ErpSettlementAllocation[]
  cashbookEntries          ErpCashbookEntry[]
  taxTransactions          ErpTaxTransaction[]
  fixedAssetTransactions   ErpFixedAssetTransaction[]
  payrollPostingBatches    ErpPayrollPostingBatch[]

  @@unique([retailOrgId, journalNo])
  @@unique([retailOrgId, sourceType, sourceId])
  @@index([companyId])
  @@index([journalBatchId])
  @@index([fiscalPeriodId])
  @@index([reversalOfJournalEntryId])
  @@index([retailOrgId, postingDate, status])
}

model GlJournalLine {
  id                 String               @id @default(uuid())
  journalEntryId     String
  accountId          String
  storeId            String?
  financeDimensionId String?
  dimensionType      String?
  dimensionCode      String?
  debitAmount        Decimal              @default(0) @db.Decimal(18, 2)
  creditAmount       Decimal              @default(0) @db.Decimal(18, 2)
  memo               String?
  createdAt          DateTime             @default(now())
  journalEntry       GlJournalEntry       @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account            GlAccount            @relation(fields: [accountId], references: [id], onDelete: NoAction)
  store              Store?               @relation(fields: [storeId], references: [id], onDelete: SetNull)
  financeDimension   ErpFinanceDimension? @relation(fields: [financeDimensionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([accountId])
  @@index([storeId])
  @@index([financeDimensionId])
  @@index([dimensionType, dimensionCode])
  @@index([journalEntryId])
}

model OperatingExpense {
  id                        String    @id @default(uuid())
  retailOrgId               String
  storeId                   String?
  expenseNo                 String
  expenseDate               DateTime
  category                  String
  description               String
  supplierName              String?
  paymentMethod             String?
  externalReference         String?
  attachmentFileName        String?
  attachmentUrl             String?
  amount                    Decimal   @db.Decimal(18, 2)
  taxAmount                 Decimal   @default(0) @db.Decimal(18, 2)
  status                    String    @default("APPROVED")
  confirmedBy               String?
  confirmedAt               DateTime?
  financeExpenseAccountCode String?
  financePaymentAccountCode String?
  financeAssignedBy         String?
  financeAssignedAt         DateTime?
  approvedBy                String?
  approvedAt                DateTime?
  postedAt                  DateTime?
  note                      String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  retailOrg                 RetailOrg @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  store                     Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([retailOrgId, expenseNo])
  @@index([retailOrgId, expenseDate, status])
  @@index([storeId])
}

