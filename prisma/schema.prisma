  retailOrgId                   String
  code                          String
  legalName                     String
  tradingName                   String?
  companyType                   String                            @default("LEGAL_ENTITY")
  registrationNo                String?
  taxRegistrationNo             String?
  baseCurrencyCode              String
  timezone                      String
  phone                         String?
  email                         String?
  addressLine1                  String?
  city                          String?
  region                        String?
  countryCode                   String?
  isPrimary                     Boolean                           @default(false)
  status                        String                            @default("ACTIVE")
  createdAt                     DateTime                          @default(now())
  updatedAt                     DateTime                          @updatedAt
  retailOrg                     RetailOrg                         @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  accountingSettings            ErpAccountingSettings?
  fiscalYears                   ErpFiscalYear[]
  fiscalPeriods                 ErpFiscalPeriod[]
  glAccounts                    GlAccount[]
  glJournalBatches              GlJournalBatch[]
  glJournalEntries              GlJournalEntry[]
  productProfiles               ErpProductProfile[]
  operatingSites                ErpOperatingSite[]
  arApPostingProfiles           ErpArApPostingProfile[]
  partyProfiles                 ErpPartyAccountingProfile[]
  documentSequences             ErpDocumentSequence[]
  operationalDocuments          ErpOperationalDocument[]
  settlementAllocations         ErpSettlementAllocation[]
  cashbookAccounts              ErpCashbookAccount[]
  cashbookEntries               ErpCashbookEntry[]
  bankStatements                ErpBankStatement[]
  bankStatementLines            ErpBankStatementLine[]
  reconciliationMatches         ErpBankReconciliationMatch[]
  taxRegistration               ErpTaxRegistration?
  taxCodes                      ErpTaxCode[]
  taxGroups                     ErpTaxGroup[]
  taxGroupLines                 ErpTaxGroupLine[]
  taxTransactions               ErpTaxTransaction[]
  fixedAssetClasses             ErpFixedAssetClass[]
  fixedAssets                   ErpFixedAsset[]
  fixedAssetBooks               ErpFixedAssetBook[]
  fixedAssetTransactions        ErpFixedAssetTransaction[]
  financeDimensions             ErpFinanceDimension[]
  hrDepartments                 ErpHrDepartment[]
  hrPositions                   ErpHrPosition[]
  employeeCategories            ErpEmployeeCategory[]
  employees                     ErpEmployee[]
  employeePayrollProfiles       ErpEmployeePayrollProfile[]
  employeePayItems              ErpEmployeePayItem[]
  employeeAttendance            ErpEmployeeAttendance[]
  attendanceChangeLogs          ErpAttendanceChangeLog[]
  leaveTypes                    ErpLeaveType[]
  employeeLeaveEntitlements     ErpEmployeeLeaveEntitlement[]
  leaveRequests                 ErpLeaveRequest[]
  hrDocuments                   ErpHrDocument[]
  employeeExits                 ErpEmployeeExit[]
  visitorVisits                 ErpVisitorVisit[]
  visitorStatusLogs             ErpVisitorStatusLog[]
  budgetVersions                ErpBudgetVersion[]
  budgetLines                   ErpBudgetLine[]
  budgetPeriodAmounts           ErpBudgetPeriodAmount[]
  payrollGlMappings             ErpPayrollGlMapping[]
  payrollPostingBatches         ErpPayrollPostingBatch[]
  payrollPostingLines           ErpPayrollPostingLine[]
  payrollStatutoryRuleSets      ErpPayrollStatutoryRuleSet[]
  payrollTaxBands               ErpPayrollTaxBand[]
  payrollRuns                   ErpPayrollRun[]
  payrollRunEmployees           ErpPayrollRunEmployee[]
  payrollRunLines               ErpPayrollRunLine[]
  payrollFilings                ErpPayrollFiling[]
  benefitPlans                  ErpBenefitPlan[]
  employeeBenefitEnrollments    ErpEmployeeBenefitEnrollment[]
  employeeLoans                 ErpEmployeeLoan[]
  employeeLoanRepayments        ErpEmployeeLoanRepayment[]
  expenseClaims                 ErpExpenseClaim[]
  expenseClaimLines             ErpExpenseClaimLine[]
  travelRequests                ErpTravelRequest[]
  travelExpenseLines            ErpTravelExpenseLine[]
  recurringJournalTemplates     ErpRecurringJournalTemplate[]
  recurringJournalTemplateLines ErpRecurringJournalTemplateLine[]
