  updatedAt                    DateTime              @updatedAt
  ecommerceFulfillment         EcommerceFulfillment  @relation(fields: [ecommerceFulfillmentId], references: [id], onDelete: Cascade)
  salesOrderLine               SalesOrderLine         @relation(fields: [salesOrderLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ecommerceFulfillmentId, status])
  @@index([productCodeSnapshot])
}

model EcommercePayment {
  id                        String                   @id @default(uuid())
  ecommerceOrderId          String
  tenderMethodId            String?
  reference                 String                   @unique
  initializationRequestKey  String                   @unique @db.NVarChar(160)
  initializationRequestHash String                   @db.NVarChar(64)
  provider                  String?
  providerReference         String?
  method                    String
  currencyCode              String
  amount                    Decimal                  @db.Decimal(18, 2)
  status                    String                   @default("PENDING")
  checkoutUrl               String?                  @db.NVarChar(Max)
  gatewayResponseJson       String?                  @db.NVarChar(Max)
  failureMessage            String?                  @db.NVarChar(Max)
  initializedAt             DateTime                 @default(now())
  verifiedAt                DateTime?
  paidAt                    DateTime?
  failedAt                  DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  ecommerceOrder            EcommerceOrder           @relation(fields: [ecommerceOrderId], references: [id], onDelete: Cascade)
  tenderMethod              TenderMethod?            @relation(fields: [tenderMethodId], references: [id], onDelete: SetNull)
  refundRequests            EcommerceRefundRequest[]

  @@index([ecommerceOrderId, status])
  @@index([provider, providerReference])
}

model EcommerceStorePaymentMethod {
  id             String       @id @default(uuid())
  retailOrgId    String
  storeId        String
  tenderMethodId String
  enabled        Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  retailOrg      RetailOrg    @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tenderMethod   TenderMethod @relation(fields: [tenderMethodId], references: [id], onDelete: Cascade)

  @@unique([storeId, tenderMethodId])
  @@index([retailOrgId, storeId, enabled, sortOrder])
  @@index([tenderMethodId])
}

model EcommerceProductReview {
  id                String                   @id @default(uuid())
  retailOrgId       String
  productId         String
  customerAccountId String
  ecommerceOrderId  String?
  rating            Int
  title             String?
  body              String?                  @db.NVarChar(Max)
  status            String                   @default("PUBLISHED")
  verifiedPurchase  Boolean                  @default(true)
  publishedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  retailOrg         RetailOrg                @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  product           Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerAccount   EcommerceCustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  ecommerceOrder    EcommerceOrder?          @relation(fields: [ecommerceOrderId], references: [id], onDelete: SetNull)

  @@unique([productId, customerAccountId])
  @@index([retailOrgId, productId, status, createdAt])
  @@index([ecommerceOrderId])
}

model EcommerceRefundRequest {
  id               String            @id @default(uuid())
  ecommerceOrderId String
  paymentId        String?
  amount           Decimal           @db.Decimal(18, 2)
  reason           String
  details          String?           @db.NVarChar(Max)
  status           String            @default("REQUESTED")
  resolutionNote   String?           @db.NVarChar(Max)
  requestedAt      DateTime          @default(now())
  reviewedAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ecommerceOrder   EcommerceOrder    @relation(fields: [ecommerceOrderId], references: [id], onDelete: Cascade)
  payment          EcommercePayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([ecommerceOrderId, status])
  @@index([paymentId])
}

model EcommerceOrderStatusEvent {
  id               String         @id @default(uuid())
  ecommerceOrderId String
  status           String
  label            String
  note             String?        @db.NVarChar(Max)
  actorType        String         @default("SYSTEM")
  actorLabel       String?
  createdAt        DateTime       @default(now())
  ecommerceOrder   EcommerceOrder @relation(fields: [ecommerceOrderId], references: [id], onDelete: Cascade)

  @@index([ecommerceOrderId, createdAt])
}

