generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "sqlserver"
  relationMode = "prisma"
}

model RetailOrg {
  id                                String                       @id @default(uuid())
  code                              String                       @unique
  name                              String
  baseCurrencyCode                  String
  timezone                          String
  companySettingsJson               String?                      @db.NVarChar(Max)
  ldapSettingsJson                  String?                      @db.NVarChar(Max)
  smtpSettingsJson                  String?                      @db.NVarChar(Max)
  smsSettingsJson                   String?                      @db.NVarChar(Max)
  optionsSettingsJson               String?                      @db.NVarChar(Max)
  passwordPolicyJson                String?                      @db.NVarChar(Max)
  loyaltyProgramEnabled             Boolean                      @default(true)
  loyaltyPointsPerCurrencyUnit      Decimal                      @default(1) @db.Decimal(12, 4)
  loyaltyRedemptionEnabled          Boolean                      @default(false)
  loyaltyRedemptionPointsStep       Int                          @default(100)
  loyaltyRedemptionValueAmount      Decimal                      @default(1) @db.Decimal(12, 2)
  loyaltyMinimumRedeemPoints        Int                          @default(100)
  loyaltyMaximumRedeemPercentOfSale Decimal                      @default(100) @db.Decimal(5, 2)
  status                            String                       @default("ACTIVE")
  createdAt                         DateTime                     @default(now())
  updatedAt                         DateTime                     @updatedAt
  stores                            Store[]
  warehouses                        Warehouse[]
  terminals                         Terminal[]
  syncNodes                         SyncNode[]
  users                             RetailUser[]
  retailUserSessions                RetailUserSession[]
  roles                             Role[]
  customers                         Customer[]
  customerAccountEntries            CustomerAccountEntry[]
  suppliers                         Supplier[]
  taxProfiles                       TaxProfile[]
  tenderMethods                     TenderMethod[]
  unitOfMeasures                    UnitOfMeasure[]
  unitOfMeasureSchedules            UnitOfMeasureSchedule[]
  giftCertificates                  GiftCertificate[]
  receiptTemplates                  ReceiptTemplate[]
  banks                             Bank[]
  bankBranches                      BankBranch[]
  bankAccounts                      BankAccount[]
  promotions                        PromotionCampaign[]
  productDepartments                ProductDepartment[]
  productCategories                 ProductCategory[]
  inventoryCatalogs                 InventoryCatalog[]
  inventoryCatalogProducts          InventoryCatalogProduct[]
  inventoryCatalogStores            InventoryCatalogStore[]
  products                          Product[]
  productAttributeDefinitions       ProductAttributeDefinition[]
  productMatrixVariants             ProductMatrixVariant[]
  priceLists                        PriceList[]
  storeProductPrices                 StoreProductPrice[]
  inventoryLocations                InventoryLocation[]
  inventoryLedgerEntries            InventoryLedgerEntry[]
  inventorySerialUnits              InventorySerialUnit[]
  purchaseOrders                    PurchaseOrder[]
  supplierClaims                    SupplierClaim[]
  supplierReturns                   SupplierReturn[]
  stockCountSessions                StockCountSession[]
  interStoreTransfers               InterStoreTransfer[]
  goodsReceipts                     GoodsReceipt[]
  posShifts                         PosShift[]
  posTransactions                   PosTransaction[]
  salesOrders                       SalesOrder[]
  eodReconciliations                EodReconciliation[]
  bankingDeposits                   BankingDeposit[]
  glAccounts                        GlAccount[]
  glJournalEntries                  GlJournalEntry[]
  operatingExpenses                 OperatingExpense[]
  transactionReferenceCaptures      TransactionReferenceCapture[]
  securityLogs                      SecurityLog[]
  licenseEvents                     LicenseEvent[]
}

model TransactionReferenceCapture {
  id                  String    @id @default(uuid())
  retailOrgId         String
  referenceValue      String
  normalizedReference String
  phoneNumber         String?
  source              String
  sourceTransactionNo String?
  customerName        String?
  notes               String?   @db.NVarChar(Max)
  firstCapturedAt     DateTime  @default(now())
  lastCapturedAt      DateTime  @updatedAt
  retailOrg           RetailOrg @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)

  @@unique([retailOrgId, normalizedReference])
  @@map("transaction_reference_capture")
}

model ReceiptTemplate {
  id            String    @id @default(uuid())
  retailOrgId   String
  code          String
  name          String
  description   String?
  templateHtml  String    @db.NVarChar(Max)
  isDefault     Boolean   @default(false)
  paperWidthMm  Int       @default(80)
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  retailOrg     RetailOrg @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  salesStores   Store[]   @relation("StoreSalesReceiptTemplate")
  accountStores Store[]   @relation("StoreAccountPaymentReceiptTemplate")

  @@unique([retailOrgId, code])
}

model Bank {
  id                     String       @id @default(uuid())
  retailOrgId            String
  code                   String
  name                   String
  description            String?
  status                 String       @default("ACTIVE")
  originNodeCode         String?
  lastModifiedByNodeCode String?
  recordVersion          Int          @default(1)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?
  retailOrg              RetailOrg    @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  branches               BankBranch[]

  @@unique([retailOrgId, code])
}

model BankBranch {
  id                     String       @id @default(uuid())
  retailOrgId            String
  bankId                 String
  code                   String
  name                   String
  addressLine1           String?
  status                 String       @default("ACTIVE")
  originNodeCode         String?
  lastModifiedByNodeCode String?
  recordVersion          Int          @default(1)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?
  retailOrg              RetailOrg    @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  bank                   Bank         @relation(fields: [bankId], references: [id], onDelete: Cascade)
  account                BankAccount?

  @@unique([retailOrgId, code])
  @@index([bankId, status])
}

model BankAccount {
  id                     String                 @id @default(uuid())
  retailOrgId            String
  branchId               String                 @unique
  accountNumber          String
  accountName            String
  currencyCode           String
  status                 String                 @default("ACTIVE")
  originNodeCode         String?
  lastModifiedByNodeCode String?
  recordVersion          Int                    @default(1)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?
  retailOrg              RetailOrg              @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  branch                 BankBranch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  posPayments            PosPayment[]
  bankingDeposits        BankingDeposit[]
  customerAccountEntries CustomerAccountEntry[]

  @@unique([retailOrgId, accountNumber])
  @@index([retailOrgId, status])
}

model Store {
  id                                String                  @id @default(uuid())
  retailOrgId                       String
  code                              String
  name                              String
  shortName                         String?
  timezone                          String
  currencyCode                      String
  salesEnabled                      Boolean                 @default(true)
  warehouseEnabled                  Boolean                 @default(true)
  phone                             String?
  email                             String?
  managerName                       String?
  location                          String?
  addressLine1                      String?
  addressLine2                      String?
  city                              String?
  region                            String?
  storeGroupCode                    String?
  storeGroupName                    String?
  storeGroupType                    String?
  countryCode                       String?
  postalCode                        String?
  taxRegistrationNo                 String?
  receiptHeader                     String?
  receiptFooter                     String?
  salesReceiptTemplateId            String?
  salesReceiptTemplateHtml          String?                 @db.NVarChar(Max)
  accountPaymentReceiptTemplateId   String?
  accountPaymentReceiptTemplateHtml String?                 @db.NVarChar(Max)
  licenseStatus                     String                  @default("UNLICENSED")
  licenseKey                        String?
  licensedUntil                     DateTime?
  catalogPolicyJson                 String?                 @db.NVarChar(Max)
  storeMode                         String                  @default("OFFLINE_FIRST")
  touchModeEnabled                  Boolean                 @default(true)
  status                            String                  @default("ACTIVE")
  openedOn                          DateTime?
  createdAt                         DateTime                @default(now())
  updatedAt                         DateTime                @updatedAt
  retailOrg                         RetailOrg               @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  salesReceiptTemplate              ReceiptTemplate?        @relation("StoreSalesReceiptTemplate", fields: [salesReceiptTemplateId], references: [id], onDelete: SetNull)
  accountPaymentReceiptTemplate     ReceiptTemplate?        @relation("StoreAccountPaymentReceiptTemplate", fields: [accountPaymentReceiptTemplateId], references: [id], onDelete: SetNull)
  warehouses                        Warehouse[]
  terminals                         Terminal[]
  syncNodes                         SyncNode[]
  homeUsers                         RetailUser[]
  customers                         Customer[]
  customerAccountEntries            CustomerAccountEntry[]
  inventoryLocations                InventoryLocation[]
  inventoryLedgerEntries            InventoryLedgerEntry[]
  inventorySerialUnits              InventorySerialUnit[]
  purchaseOrders                    PurchaseOrder[]
  supplierClaims                    SupplierClaim[]
  supplierReturns                   SupplierReturn[]
  stockCountSessions                StockCountSession[]
  outboundInterStoreTransfers       InterStoreTransfer[]    @relation("InterStoreTransferSourceStore")
  inboundInterStoreTransfers        InterStoreTransfer[]    @relation("InterStoreTransferDestinationStore")
  goodsReceipts                     GoodsReceipt[]
  posShifts                         PosShift[]
  posTransactions                   PosTransaction[]
  salesOrders                       SalesOrder[]
  eodReconciliations                EodReconciliation[]
  bankingDeposits                   BankingDeposit[]
  glJournalLines                    GlJournalLine[]
  operatingExpenses                 OperatingExpense[]
  giftCertificates                  GiftCertificate[]
  inventoryCatalogLinks             InventoryCatalogStore[]
  storeProductPrices                 StoreProductPrice[]
  licenseEvents                     LicenseEvent[]

  @@unique([retailOrgId, code])
  @@index([retailOrgId, storeGroupCode])
  @@index([retailOrgId, licenseStatus])
  @@index([retailOrgId, storeMode])
  @@index([salesReceiptTemplateId])
  @@index([accountPaymentReceiptTemplateId])
}

model GlAccount {
  id            String          @id @default(uuid())
  retailOrgId   String
  code          String
  name          String
  accountType   String
  normalBalance String
  externalCode  String?
  description   String?
  status        String          @default("ACTIVE")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  retailOrg     RetailOrg       @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  journalLines  GlJournalLine[]

  @@unique([retailOrgId, code])
  @@index([retailOrgId, accountType, status])
}

model GlJournalEntry {
  id              String          @id @default(uuid())
  retailOrgId     String
  journalNo       String
  sourceType      String
  sourceId        String
  sourceReference String?
  postingDate     DateTime
  description     String
  status          String          @default("POSTED")
  postedAt        DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  retailOrg       RetailOrg       @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  lines           GlJournalLine[]

  @@unique([retailOrgId, journalNo])
  @@unique([retailOrgId, sourceType, sourceId])
  @@index([retailOrgId, postingDate, status])
}

model GlJournalLine {
  id             String         @id @default(uuid())
  journalEntryId String
  accountId      String
  storeId        String?
  debitAmount    Decimal        @default(0) @db.Decimal(18, 2)
  creditAmount   Decimal        @default(0) @db.Decimal(18, 2)
  memo           String?
  createdAt      DateTime       @default(now())
  journalEntry   GlJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        GlAccount      @relation(fields: [accountId], references: [id], onDelete: NoAction)
  store          Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([storeId])
  @@index([journalEntryId])
}

model OperatingExpense {
  id                String    @id @default(uuid())
  retailOrgId       String
  storeId           String?
  expenseNo         String
  expenseDate       DateTime
  category          String
  description       String
  supplierName      String?
  paymentMethod     String?
  externalReference String?
  amount            Decimal   @db.Decimal(18, 2)
  taxAmount         Decimal   @default(0) @db.Decimal(18, 2)
  status            String    @default("APPROVED")
  approvedBy        String?
  approvedAt        DateTime?
  postedAt          DateTime?
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  retailOrg         RetailOrg @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  store             Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([retailOrgId, expenseNo])
  @@index([retailOrgId, expenseDate, status])
  @@index([storeId])
}

model Warehouse {
  id                     String                 @id @default(uuid())
  retailOrgId            String
  storeId                String?
  code                   String
  name                   String
  licenseStatus          String                 @default("UNLICENSED")
  licenseKey             String?
  licensedUntil          DateTime?
  status                 String                 @default("ACTIVE")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  retailOrg              RetailOrg              @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  store                  Store?                 @relation(fields: [storeId], references: [id], onDelete: SetNull)
  inventoryLocations     InventoryLocation[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  inventorySerialUnits   InventorySerialUnit[]
  purchaseOrders         PurchaseOrder[]
  supplierClaims         SupplierClaim[]
  supplierReturns        SupplierReturn[]
  stockCountSessions     StockCountSession[]
  goodsReceipts          GoodsReceipt[]

  @@unique([retailOrgId, code])
  @@index([storeId])
}

model Terminal {
  id                     String                 @id @default(uuid())
  retailOrgId            String
  storeId                String
  code                   String
  name                   String
  status                 String                 @default("ACTIVE")
  licenseStatus          String                 @default("UNLICENSED")
  licenseKey             String?
  licensedUntil          DateTime?
  registeredAt           DateTime               @default(now())
  lastHeartbeatAt        DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  retailOrg              RetailOrg              @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  store                  Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  syncNodes              SyncNode[]
  posShifts              PosShift[]
  posTransactions        PosTransaction[]
  customerAccountEntries CustomerAccountEntry[]
  salesOrders            SalesOrder[]
  eodReconciliations     EodReconciliation[]
  bankingDeposits        BankingDeposit[]
  licenseEvents          LicenseEvent[]

  @@unique([storeId, code])
  @@index([retailOrgId, licenseStatus])
}

model LicenseEvent {
  id                    String    @id @default(uuid())
  retailOrgId           String
  storeId               String?
  terminalId            String?
  scope                 String
  action                String
  previousStatus        String?
  newStatus             String
  previousLicensedUntil DateTime?
  newLicensedUntil      DateTime?
  previousLicenseKey    String?
  newLicenseKey         String?
  operatorName          String?
  note                  String?
  createdAt             DateTime  @default(now())
  retailOrg             RetailOrg @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  store                 Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  terminal              Terminal? @relation(fields: [terminalId], references: [id], onDelete: SetNull)

  @@index([retailOrgId, createdAt])
  @@index([storeId, createdAt])
  @@index([terminalId, createdAt])
}

model SyncNode {
  id                           String                @id @default(uuid())
  retailOrgId                  String
  storeId                      String?
  terminalId                   String?
  code                         String                @unique
  name                         String
  nodeType                     String
  direction                    String                @default("BIDIRECTIONAL")
  isPrimary                    Boolean               @default(false)
  status                       String                @default("ACTIVE")
  lastHeartbeatAt              DateTime?
  lastTelemetryAt              DateTime?
  lastReportedHealth           String?
  lastReportedUpstreamQueued   Int?
  lastReportedUpstreamInFlight Int?
  lastReportedDownstreamQueued Int?
  lastReportedDeadLetter       Int?
  lastReportedLastSyncAt       DateTime?
  lastReportedLastLocalWriteAt DateTime?
  autoSyncEnabled              Boolean               @default(true)
  syncIntervalMinutes          Int                   @default(15)
  syncActiveFromMinutes        Int                   @default(0)
  syncActiveToMinutes          Int                   @default(1440)
  syncJitterSeconds            Int                   @default(30)
  syncBackoffBaseSeconds       Int                   @default(60)
  syncBackoffMaxSeconds        Int                   @default(900)
  nextScheduledSyncAt          DateTime?
  lastManualSyncAt             DateTime?
  lastAutoSyncAt               DateTime?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  retailOrg                    RetailOrg             @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  store                        Store?                @relation(fields: [storeId], references: [id], onDelete: SetNull)
  terminal                     Terminal?             @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  outboxEvents                 SyncOutboxEvent[]
  inboundEvents                SyncInboundEvent[]
  inboxCheckpoints             SyncInboxCheckpoint[]
  operatorActions              SyncOperatorAction[]

  @@index([retailOrgId])
  @@index([storeId])
  @@index([terminalId])
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model Role {
  id              String           @id @default(uuid())
  retailOrgId     String
  code            String
  name            String
  description     String?
  status          String           @default("ACTIVE")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  retailOrg       RetailOrg        @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       RetailUserRole[]

  @@unique([retailOrgId, code])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RetailUser {
  id                     String              @id @default(uuid())
  retailOrgId            String
  homeStoreId            String?
  loginId                String
  email                  String?
  displayName            String
  passwordHash           String?
  passwordUpdatedAt      DateTime?
  failedLoginAttempts    Int                 @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  accountStatus          String              @default("INVITED")
  originNodeCode         String?
  lastModifiedByNodeCode String?
  recordVersion          Int                 @default(1)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  deletedAt              DateTime?
  retailOrg              RetailOrg           @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  homeStore              Store?              @relation(fields: [homeStoreId], references: [id], onDelete: SetNull)
  userRoles              RetailUserRole[]
  openedShifts           PosShift[]
  sessions               RetailUserSession[]

  @@unique([retailOrgId, loginId])
  @@index([homeStoreId])
}

model RetailUserRole {
  retailUserId String
  roleId       String
  assignedAt   DateTime   @default(now())
  retailUser   RetailUser @relation(fields: [retailUserId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([retailUserId, roleId])
  @@index([roleId])
}

model RetailUserSession {
  id           String     @id @default(uuid())
  retailOrgId  String
  retailUserId String
  tokenHash    String     @unique
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  retailOrg    RetailOrg  @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  retailUser   RetailUser @relation(fields: [retailUserId], references: [id], onDelete: Cascade)

  @@index([retailUserId, expiresAt])
  @@index([retailOrgId])
}

model Customer {
  id                      String                 @id @default(uuid())
  retailOrgId             String
  storeId                 String?
  customerNo              String
  customerType            String                 @default("INDIVIDUAL")
  fullName                String
  phone                   String?
  email                   String?
  addressLine1            String?
  city                    String?
  countryCode             String?
  loyaltyEnrolled         Boolean                @default(false)
  loyaltyTier             String?
  loyaltyPointsBalance    Int                    @default(0)
  allowCreditSales        Boolean                @default(false)
  creditLimitAmount       Decimal?               @db.Decimal(12, 2)
  receivableBalanceAmount Decimal                @default(0) @db.Decimal(12, 2)
  note                    String?
  status                  String                 @default("ACTIVE")
  originNodeCode          String?
  lastModifiedByNodeCode  String?
  recordVersion           Int                    @default(1)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  deletedAt               DateTime?
  retailOrg               RetailOrg              @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  store                   Store?                 @relation(fields: [storeId], references: [id], onDelete: SetNull)
  posTransactions         PosTransaction[]
  accountEntries          CustomerAccountEntry[]
  salesOrders             SalesOrder[]

  @@unique([retailOrgId, customerNo])
  @@index([storeId])
}

model CustomerAccountEntry {
  id                            String          @id @default(uuid())
  retailOrgId                   String
  customerId                    String
  storeId                       String?
  terminalId                    String?
  posTransactionId              String?
  bankAccountId                 String?
  entryType                     String
  transactionNoSnapshot         String?
  sourceTransactionNoSnapshot   String?
  bankCodeSnapshot              String?
  bankNameSnapshot              String?
  bankBranchCodeSnapshot        String?
  bankBranchNameSnapshot        String?
  bankAccountNumberSnapshot     String?
  bankAccountNameSnapshot       String?
  receivableDeltaAmount         Decimal         @default(0) @db.Decimal(12, 2)
  loyaltyPointsDelta            Int             @default(0)
  resultingReceivableBalance    Decimal         @default(0) @db.Decimal(12, 2)
  resultingLoyaltyPointsBalance Int             @default(0)
  note                          String?
  originNodeCode                String?
  occurredAt                    DateTime
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt
  retailOrg                     RetailOrg       @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  customer                      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store                         Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  terminal                      Terminal?       @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  posTransaction                PosTransaction? @relation(fields: [posTransactionId], references: [id], onDelete: SetNull)
  bankAccount                   BankAccount?    @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
  @@index([posTransactionId])
  @@index([retailOrgId, occurredAt])
  @@index([bankAccountId])
  @@index([storeId])
  @@index([terminalId])
}

model Supplier {
  id                     String            @id @default(uuid())
  retailOrgId            String
  supplierNo             String
  name                   String
  contactName            String?
  phone                  String?
  email                  String?
  addressLine1           String?
  city                   String?
  countryCode            String?
  leadTimeDays           Int?
  status                 String            @default("ACTIVE")
  originNodeCode         String?
  lastModifiedByNodeCode String?
  recordVersion          Int               @default(1)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?
  retailOrg              RetailOrg         @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  productSuppliers       ProductSupplier[]
  purchaseOrders         PurchaseOrder[]
  supplierClaims         SupplierClaim[]
  supplierReturns        SupplierReturn[]
  goodsReceipts          GoodsReceipt[]

  @@unique([retailOrgId, supplierNo])
}

model TaxProfile {
  id                     String    @id @default(uuid())
  retailOrgId            String
  code                   String
  name                   String
  description            String?
  ratePercent            Decimal   @db.Decimal(5, 2)
  isDefault              Boolean   @default(false)
  isTaxInclusive         Boolean   @default(false)
  status                 String    @default("ACTIVE")
  originNodeCode         String?
  lastModifiedByNodeCode String?
  recordVersion          Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  retailOrg              RetailOrg @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  products               Product[]

  @@unique([retailOrgId, code])
}

model TenderMethod {
  id                       String       @id @default(uuid())
  retailOrgId              String
  code                     String
  name                     String
  paymentMethod            String
  gatewayProvider          String?
  gatewayMode              String?
  gatewayMerchantId        String?
  gatewayPublicKey         String?
  gatewaySecretMask        String?
  gatewayWebhookSecretMask String?
  gatewayCallbackUrl       String?
  gatewayActive            Boolean      @default(false)
  gatewayStatus            String       @default("DISABLED")
  gatewayConfigJson        String?      @db.NVarChar(Max)
  description              String?
  requiresReference        Boolean      @default(false)
  allowChange              Boolean      @default(false)
  allowRefund              Boolean      @default(true)
  allowOpenCashDrawer      Boolean      @default(false)
  sortOrder                Int          @default(0)
  status                   String       @default("ACTIVE")
  originNodeCode           String?
  lastModifiedByNodeCode   String?
  recordVersion            Int          @default(1)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  deletedAt                DateTime?
  retailOrg                RetailOrg    @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
