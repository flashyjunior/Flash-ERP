  sellingUnitOfMeasure       String                           @default("EA")
  baseUnitOfMeasure          String                           @default("EA")
  uomConversionFactor        Decimal                          @default(1) @db.Decimal(18, 6)
  baseQuantity               Decimal                          @default(0) @db.Decimal(18, 3)
  unitPrice                  Decimal                          @db.Decimal(18, 2)
  discountAmount             Decimal                          @default(0) @db.Decimal(18, 2)
  taxAmount                  Decimal                          @default(0) @db.Decimal(18, 2)
  lineTotal                  Decimal                          @db.Decimal(18, 2)
  appliedPromotionCode       String?
  appliedPromotionName       String?
  salesOrder                 SalesOrder                       @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  inventoryReservations      SalesOrderInventoryReservation[]
  ecommerceFulfillmentLine   EcommerceFulfillmentLine?

  @@index([salesOrderId])
  @@index([productCodeSnapshot])
}

model SalesOrderInventoryReservation {
  id                            String         @id @default(uuid())
  salesOrderId                  String
  salesOrderLineId              String
  inventoryLocationId           String?
  inventoryLocationCodeSnapshot String?
  productCodeSnapshot           String
  productVariantCodeSnapshot    String?
  baseUnitOfMeasure             String         @default("EA")
  baseQuantity                  Decimal        @db.Decimal(18, 3)
  status                        String         @default("ACTIVE")
  releaseReason                 String?
  createdAt                     DateTime       @default(now())
  releasedAt                    DateTime?
  updatedAt                     DateTime       @updatedAt
  salesOrder                    SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderLine                SalesOrderLine @relation(fields: [salesOrderLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([salesOrderId, salesOrderLineId, inventoryLocationId])
  @@index([salesOrderId, status])
  @@index([inventoryLocationId, productCodeSnapshot, productVariantCodeSnapshot, status])
  @@index([productCodeSnapshot, status])
}

model EcommerceCustomerAccount {
  id                  String                      @id @default(uuid())
  retailOrgId         String
  customerId          String                      @unique
  passwordHash        String
  status              String                      @default("PENDING_VERIFICATION")
  passwordUpdatedAt   DateTime                    @default(now())
  failedLoginAttempts Int                         @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  retailOrg           RetailOrg                   @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  customer            Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  identities          EcommerceCustomerIdentity[]
  sessions            EcommerceCustomerSession[]
  addresses           EcommerceCustomerAddress[]
  orders              EcommerceOrder[]
  reviews             EcommerceProductReview[]

  @@index([retailOrgId, status])
}

model EcommerceCustomerIdentity {
  id                   String                   @id @default(uuid())
  retailOrgId          String
  customerAccountId    String
  identityType         String
  identifier           String
  identifierNormalized String
  isPrimary            Boolean                  @default(false)
  verifiedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  retailOrg            RetailOrg                @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  customerAccount      EcommerceCustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@unique([retailOrgId, identityType, identifierNormalized])
  @@index([customerAccountId, isPrimary])
}

model EcommerceCustomerSession {
  id                String                   @id @default(uuid())
  retailOrgId       String
  customerAccountId String
  tokenHash         String                   @unique
  expiresAt         DateTime
  lastSeenAt        DateTime                 @default(now())
  revokedAt         DateTime?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime                 @default(now())
  retailOrg         RetailOrg                @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  customerAccount   EcommerceCustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, expiresAt])
  @@index([retailOrgId, expiresAt])
}

model EcommerceOtpChallenge {
  id                   String    @id @default(uuid())
  retailOrgId          String
  identityType         String
  identifier           String
  identifierNormalized String
  purpose              String
  codeHash             String
  attemptCount         Int       @default(0)
  maxAttempts          Int       @default(5)
  expiresAt            DateTime
  resendAvailableAt    DateTime
  consumedAt           DateTime?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime  @default(now())
  retailOrg            RetailOrg @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)

  @@index([retailOrgId, identityType, identifierNormalized, purpose, createdAt])
  @@index([expiresAt, consumedAt])
}

model EcommerceCustomerAddress {
  id                String                   @id @default(uuid())
  customerAccountId String
  label             String?
  recipientName     String
  phone             String
  addressLine1      String
  addressLine2      String?
  city              String
  region            String?
  countryCode       String                   @default("GH")
  postalCode        String?
  deliveryNote      String?                  @db.NVarChar(Max)
  isDefault         Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  customerAccount   EcommerceCustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, isDefault])
}

model EcommerceFulfillmentLocation {
  id                  String            @id @default(uuid())
  retailOrgId         String
  storefrontStoreId   String
  storeId             String
  inventoryLocationId String
  status              String            @default("ACTIVE")
  supportsPickup      Boolean           @default(true)
  supportsDelivery    Boolean           @default(true)
  routingPriority     Int               @default(100)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  retailOrg           RetailOrg         @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  storefrontStore     Store             @relation("EcommerceStorefrontFulfillmentLocation", fields: [storefrontStoreId], references: [id], onDelete: Cascade)
  store               Store             @relation("EcommerceFulfillmentStore", fields: [storeId], references: [id], onDelete: Cascade)
  inventoryLocation   InventoryLocation @relation(fields: [inventoryLocationId], references: [id], onDelete: Cascade)
  fulfillments        EcommerceFulfillment[]

  @@unique([storefrontStoreId, inventoryLocationId])
  @@index([retailOrgId, storefrontStoreId, status, routingPriority])
  @@index([storeId, status])
  @@index([inventoryLocationId])
}

model EcommerceOrder {
  id                        String                      @id @default(uuid())
  retailOrgId               String
  storeId                   String
  storefrontStoreId         String?
  salesOrderId              String                      @unique
  customerAccountId         String
  orderNo                   String
  checkoutRequestKey        String                      @unique @db.NVarChar(160)
  checkoutRequestHash       String                      @db.NVarChar(64)
  status                    String                      @default("PLACED")
  paymentStatus             String                      @default("UNPAID")
  deliveryStatus            String                      @default("PENDING")
  fulfilmentMethod          String                      @default("DELIVERY")
  currencyCode              String
  itemsSubtotalAmount       Decimal                     @db.Decimal(18, 2)
  discountAmount            Decimal                     @default(0) @db.Decimal(18, 2)
  taxAmount                 Decimal                     @default(0) @db.Decimal(18, 2)
  deliveryFeeAmount         Decimal                     @default(0) @db.Decimal(18, 2)
  totalAmount               Decimal                     @db.Decimal(18, 2)
  paidAmount                Decimal                     @default(0) @db.Decimal(18, 2)
  balanceAmount             Decimal                     @db.Decimal(18, 2)
  layawayDepositAmount      Decimal                     @default(0) @db.Decimal(18, 2)
  recipientName             String
  deliveryPhone             String
  deliveryAddressLine1      String?
  deliveryAddressLine2      String?
  deliveryCity              String?
  deliveryRegion            String?
  deliveryCountryCode       String?
  deliveryPostalCode        String?
  deliveryNote              String?                     @db.NVarChar(Max)
  customerNote              String?                     @db.NVarChar(Max)
  trackingReference         String?
  paymentTiming             String                      @default("ON_DELIVERY")
  selectedPaymentMethodCode String?
  selectedPaymentMethodName String?
  placedAt                  DateTime                    @default(now())
  confirmedAt               DateTime?
  processingAt              DateTime?
  readyAt                   DateTime?
  dispatchedAt              DateTime?
  deliveredAt               DateTime?
  cancelledAt               DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  retailOrg                 RetailOrg                   @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  store                     Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storefrontStore           Store?                      @relation("EcommerceStorefront", fields: [storefrontStoreId], references: [id], onDelete: SetNull)
  salesOrder                SalesOrder                  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  customerAccount           EcommerceCustomerAccount    @relation(fields: [customerAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments                  EcommercePayment[]
  refundRequests            EcommerceRefundRequest[]
  statusEvents              EcommerceOrderStatusEvent[]
  reviews                   EcommerceProductReview[]
  fulfillments              EcommerceFulfillment[]

  @@unique([retailOrgId, orderNo])
  @@index([storeId, status, updatedAt])
  @@index([storefrontStoreId, status, updatedAt])
  @@index([customerAccountId, placedAt])
  @@index([paymentStatus, updatedAt])
  @@index([deliveryStatus, updatedAt])
}

model EcommerceFulfillment {
  id                            String                       @id @default(uuid())
  retailOrgId                   String
  ecommerceOrderId              String
  ecommerceFulfillmentLocationId String?
  storeId                       String
  inventoryLocationId           String?
  salesOrderId                  String                       @unique
  sequenceNo                    Int                          @default(1)
  status                        String                       @default("PLACED")
  fulfilmentMethod              String
  routingMethod                 String                       @default("PRIORITY_STOCK")
  storeCodeSnapshot             String
  storeNameSnapshot             String
  inventoryLocationCodeSnapshot String?
  inventoryLocationNameSnapshot String?
  assignedAt                    DateTime                     @default(now())
  fulfilledAt                   DateTime?
  cancelledAt                   DateTime?
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  retailOrg                     RetailOrg                    @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)
  ecommerceOrder                EcommerceOrder               @relation(fields: [ecommerceOrderId], references: [id], onDelete: Cascade)
  ecommerceFulfillmentLocation  EcommerceFulfillmentLocation? @relation(fields: [ecommerceFulfillmentLocationId], references: [id], onDelete: SetNull)
  store                         Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryLocation             InventoryLocation?           @relation(fields: [inventoryLocationId], references: [id], onDelete: SetNull)
  salesOrder                    SalesOrder                   @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  lines                         EcommerceFulfillmentLine[]

  @@unique([ecommerceOrderId, sequenceNo])
  @@index([retailOrgId, storeId, status, updatedAt])
  @@index([ecommerceFulfillmentLocationId])
  @@index([inventoryLocationId])
}

model EcommerceFulfillmentLine {
  id                          String                @id @default(uuid())
  ecommerceFulfillmentId       String
  salesOrderLineId             String                @unique
  productCodeSnapshot          String
  productVariantCodeSnapshot   String?
  productNameSnapshot          String
  sellingUnitOfMeasure         String
  baseUnitOfMeasure            String
  uomConversionFactor          Decimal               @db.Decimal(18, 6)
  quantity                     Decimal               @db.Decimal(18, 3)
  baseQuantity                 Decimal               @db.Decimal(18, 3)
  status                       String                @default("ALLOCATED")
