model SyncOutboxEvent {
  id              String               @id @default(uuid())
  syncNodeId      String
  targetNodeCode  String?
  aggregateType   String
  aggregateId     String
  eventType       String
  idempotencyKey  String               @unique
  payload         String               @db.NVarChar(Max)
  status          String               @default("PENDING")
  attemptCount    Int                  @default(0)
  errorMessage    String?              @db.NVarChar(Max)
  lastAttemptAt   DateTime?
  acknowledgedAt  DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  syncNode        SyncNode             @relation(fields: [syncNodeId], references: [id], onDelete: Cascade)
  operatorActions SyncOperatorAction[]

  @@index([syncNodeId])
  @@index([syncNodeId, targetNodeCode, eventType])
  @@index([syncNodeId, targetNodeCode, status, createdAt])
  @@index([syncNodeId, targetNodeCode, status, lastAttemptAt])
  @@index([syncNodeId, targetNodeCode, acknowledgedAt])
}

model SyncInboundEvent {
  id              String               @id @default(uuid())
  syncNodeId      String
  sourceNodeCode  String
  aggregateType   String
  aggregateId     String
  eventType       String
  idempotencyKey  String               @unique
  recordVersion   Int                  @default(1)
  payload         String               @db.NVarChar(Max)
  status          String               @default("ACKNOWLEDGED")
  receivedAt      DateTime             @default(now())
  appliedAt       DateTime?
  errorMessage    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  syncNode        SyncNode             @relation(fields: [syncNodeId], references: [id], onDelete: Cascade)
  operatorActions SyncOperatorAction[]

  @@index([syncNodeId])
  @@index([syncNodeId, sourceNodeCode, status, receivedAt])
  @@index([syncNodeId, sourceNodeCode, aggregateType, aggregateId])
}

model SyncInboxCheckpoint {
  id                 String    @id @default(uuid())
  syncNodeId         String
  remoteNodeCode     String
  lastEventId        String?
  lastReceivedCursor String?
  lastReceivedAt     DateTime?
  lastAppliedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  syncNode           SyncNode  @relation(fields: [syncNodeId], references: [id], onDelete: Cascade)

  @@unique([syncNodeId, remoteNodeCode])
}

model SyncOperatorAction {
  id                 String            @id @default(uuid())
  syncNodeId         String
  syncOutboxEventId  String?
  syncInboundEventId String?
  actionType         String
  operatorName       String
  note               String
  aggregateType      String?
  eventType          String?
  createdAt          DateTime          @default(now())
  syncNode           SyncNode          @relation(fields: [syncNodeId], references: [id], onDelete: Cascade)
  syncOutboxEvent    SyncOutboxEvent?  @relation(fields: [syncOutboxEventId], references: [id], onDelete: SetNull)
  syncInboundEvent   SyncInboundEvent? @relation(fields: [syncInboundEventId], references: [id], onDelete: SetNull)

  @@index([syncNodeId])
  @@index([syncOutboxEventId])
  @@index([syncInboundEventId])
}

model SecurityLog {
  id             String    @id @default(uuid())
  retailOrgId    String
  kind           String
  severity       String    @default("INFO")
  category       String
  action         String
  actorLabel     String
  targetType     String?
  targetRef      String?
  sourceNodeCode String?
  message        String
  detailsJson    String?   @db.NVarChar(Max)
  createdAt      DateTime  @default(now())
  retailOrg      RetailOrg @relation(fields: [retailOrgId], references: [id], onDelete: Cascade)

  @@index([retailOrgId, createdAt])
  @@index([retailOrgId, kind, createdAt])
  @@index([retailOrgId, category, createdAt])
}
