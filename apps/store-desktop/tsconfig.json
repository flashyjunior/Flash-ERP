{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@flash-erp/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@flash-erp/domain/*": [
        "../../packages/domain/src/*"
      ],
      "@flash-erp/sync-core": [
        "../../packages/sync-core/src/index.ts"
      ],
      "@flash-erp/sync-core/*": [
        "../../packages/sync-core/src/*"
      ],
      "@renderer/*": [
        "./src/renderer/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  },
  "include": [
    "electron/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ]
}
