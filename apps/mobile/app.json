{
  "expo": {
    "name": "Flash ERP",
    "slug": "flash-erp-mobile",
    "version": "1.0.2",
    "scheme": "flasherp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090d16"
    },
    "ios": {
      "bundleIdentifier": "com.flasherp.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Flash ERP uses the camera to scan product barcodes and capture fuel delivery evidence photos.",
        "NSPhotoLibraryUsageDescription": "Flash ERP accesses photos to attach receipts to expense claims."
      }
    },
    "android": {
      "package": "com.flasherp.mobile",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      },
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Flash ERP to access the camera for barcode scanning."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad0548e9-dcec-4159-bd8a-9a12583f593f"
      }
    }
  }
}
