{
  "name": "flash-erp-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:enterprise",
    "dev:enterprise": "npm --workspace @flash-erp/enterprise-web run dev",
    "dev:desktop": "npm --workspace @flash-erp/store-desktop run dev",
    "preview:desktop": "npm --workspace @flash-erp/store-desktop run preview",
    "dev:mobile": "npm --workspace @flash-erp/mobile run start",
    "build": "npm run build:domain && npm run build:sync && npm run build:enterprise && npm run build:desktop",
    "build:deploy": "npm run build:domain && npm run build:sync && npm run build:enterprise:deploy",
    "build:domain": "npm --workspace @flash-erp/domain run build",
    "build:sync": "npm --workspace @flash-erp/sync-core run build",
    "build:enterprise": "npm --workspace @flash-erp/enterprise-web run build",
    "build:enterprise:deploy": "node scripts/build-enterprise-web-deploy.mjs",
    "build:desktop": "npm --workspace @flash-erp/store-desktop run build",
    "start": "npm --workspace @flash-erp/enterprise-web run start",
    "start:enterprise:cluster": "node scripts/start-enterprise-web-cluster.mjs",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "acceptance:mobile-startup": "tsx scripts/mobile-startup-gate.ts",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "prisma:format": "prisma format --schema=prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed:clothing": "tsx scripts/seed-clothing-catalog.ts",
    "smoke:desktop": "tsx scripts/desktop-smoke-check.ts",
    "smoke:enterprise-schema-compatibility": "tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/enterprise-schema-compatibility-smoke.ts",
    "soak:desktop": "tsx scripts/desktop-soak-gate.ts",
    "cert:hardware": "tsx scripts/desktop-hardware-certification-gate.ts",
    "acceptance:rms": "tsx scripts/rms-acceptance-gates.ts",
    "acceptance:sync-hardening": "tsx scripts/sync-hardening-gates.ts",
    "acceptance:desktop-sync-recovery": "node --experimental-sqlite --import tsx scripts/desktop-sync-recovery-gate.ts",
    "acceptance:inventory-search": "tsx scripts/enterprise-inventory-search-gate.ts",
    "acceptance:store-pricing-search": "tsx scripts/store-pricing-product-search-gate.ts",
    "acceptance:enterprise-authorization": "tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/enterprise-navigation-permissions-gate.ts && tsx scripts/enterprise-navigation-route-security-gate.ts && tsx scripts/enterprise-direct-route-security-gate.ts && tsx scripts/enterprise-finance-fuel-permissions-gate.ts && tsx scripts/enterprise-mutation-route-auth-gate.ts && tsx scripts/enterprise-sync-admin-route-auth-gate.ts",
    "acceptance:sales-order-payments": "node --experimental-sqlite --import tsx scripts/sales-order-payment-attribution-gate.ts",
    "acceptance:sales-order-balance": "tsx scripts/sales-order-balance-regression-gate.ts",
    "acceptance:sales-order-collections": "tsx scripts/sales-order-collections-reconciliation-gate.ts",
    "acceptance:desktop-update-artifact": "tsx scripts/desktop-update-artifact-name-gate.ts",
    "acceptance:desktop-stability": "tsx scripts/desktop-stability-gates.ts",
    "acceptance:parity": "tsx scripts/rms-parity-closure-gates.ts && npm run acceptance:online-store-parity",
    "acceptance:online-store-parity": "tsx scripts/online-store-desktop-parity-gate.ts",
    "acceptance:expiry": "tsx scripts/inventory-expiry-gate.ts",
    "acceptance:alternate-uom": "tsx scripts/alternate-uom-selling-gate.ts && node --experimental-sqlite --import tsx scripts/alternate-uom-desktop-runtime-gate.ts",
    "acceptance:alternate-uom:providers": "tsx scripts/alternate-uom-server-provider-runtime-gate.ts",
    "acceptance:alternate-uom:sqlserver": "tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/alternate-uom-sqlserver-migration-gate.ts",
    "acceptance:transfer-requests": "node --experimental-sqlite --import tsx scripts/inter-store-transfer-request-workflow-gate.ts",
    "acceptance:transfer-publication": "node --experimental-sqlite --import tsx scripts/inter-store-transfer-downstream-publication-gate.ts",
    "acceptance:stock-count-sheets": "node --experimental-sqlite --import tsx scripts/stock-count-sheet-workflow-gate.ts",
    "acceptance:layaway-policy": "node --experimental-sqlite --import tsx scripts/layaway-policy-permissions-gate.ts",
    "acceptance:layaway-lifecycle": "node --experimental-sqlite --import tsx scripts/layaway-lifecycle-gate.ts",
    "acceptance:layaway:sqlserver": "node --import tsx scripts/layaway-sqlserver-migration-gate.ts",
    "acceptance:layaway-finance": "tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/layaway-finance-reporting-gate.ts",
    "acceptance:layaway-ecommerce": "node --import tsx scripts/ecommerce-layaway-offer-gate.ts",
    "acceptance:ecommerce-multi-branch": "node --import tsx scripts/ecommerce-multi-branch-fulfillment-gate.ts && tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/ecommerce-network-allocation-gate.ts && tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/ecommerce-storefront-regression-gate.ts && tsx scripts/ecommerce-payment-reconciliation-gate.ts",
    "acceptance:ecommerce-performance": "tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/ecommerce-performance-gate.ts",
    "acceptance:ecommerce-auth": "tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/ecommerce-oauth-regression-gate.ts",
    "trial:support": "tsx scripts/trial-workspace-support-credentials.ts",
    "acceptance:trial-signup": "tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/trial-signup-gate.ts",
    "acceptance:trial-lifecycle": "tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/trial-workspace-lifecycle-gate.ts && tsc -p scripts/tsconfig.trial-provisioner.json --noEmit",
    "acceptance:vps-deploy": "tsx scripts/vps-one-command-deployment-gate.ts",
    "acceptance:trial-sample-data": "tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/trial-sample-data-gate.ts",
    "acceptance:enterprise-password-recovery": "tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/enterprise-password-recovery-gate.ts",
    "acceptance:license-renewal": "tsx scripts/enterprise-license-renewal-gate.ts",
    "acceptance:trial-lifecycle:disposable": "tsx scripts/trial-workspace-disposable-test.ts",
    "acceptance:trial-signup:browser": "playwright test tests/e2e/public-trial-signup.spec.ts --project=enterprise-browser",
    "acceptance:sync-chaos": "tsx scripts/sync-chaos-reconciliation-gate.ts",
    "cert:installed-soak": "tsx scripts/installed-desktop-soak-evidence-gate.ts",
    "cert:security-providers": "tsx scripts/security-provider-certification-gate.ts",
    "cert:hardware-execution": "tsx scripts/hardware-execution-evidence-gate.ts",
    "cert:database-readiness": "tsx scripts/database-readiness-gate.ts",
    "cert:desktop-sync-mssql": "tsx scripts/desktop-sync-mssql-certification-gate.ts",
    "acceptance:functional-uat": "tsx scripts/functional-uat-certification-gate.ts",
    "acceptance:production-hardening": "npm run acceptance:sync-chaos && npm run cert:installed-soak && npm run cert:security-providers && npm run cert:hardware-execution && npm run acceptance:functional-uat && npm run cert:database-readiness && npm run acceptance:capacity-hardening",
    "acceptance:capacity-hardening": "tsx scripts/enterprise-capacity-hardening-gate.ts",
    "acceptance:shared-cache": "tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/enterprise-shared-cache-gate.ts",
    "capacity:load": "node scripts/enterprise-capacity-load-test.mjs",
    "capacity:soak": "node scripts/enterprise-capacity-soak-test.mjs",
    "capacity:test-user": "tsx scripts/enterprise-capacity-test-user.ts",
    "capacity:idempotency": "tsx scripts/enterprise-idempotency-concurrency-test.ts",
    "capacity:ecommerce-contention": "tsx --tsconfig=apps/enterprise-web/tsconfig.json scripts/ecommerce-checkout-contention-test.ts",
    "audit:query-budgets": "tsx scripts/enterprise-query-budget-audit.ts",
    "audit:write-guards": "tsx scripts/enterprise-write-guard-audit.ts",
    "audit:domain-catalog": "node scripts/enterprise-domain-catalog-audit.mjs",
    "acceptance:inventory-drilldown": "node scripts/enterprise-inventory-drilldown-gate.mjs",
    "acceptance:e2e": "tsx scripts/rms-e2e-certification-gates.ts",
    "e2e:browser": "playwright test --project=enterprise-browser",
    "e2e:electron": "playwright test --project=store-electron",
    "e2e:certification": "playwright test",
    "bootstrap:enterprise-admin": "tsx scripts/bootstrap-enterprise-admin.ts",
    "bootstrap:store-operators": "tsx scripts/bootstrap-store-operators.ts",
    "data:import-production-stock": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/import-production-stock-workbook.ps1",
    "typecheck:production-stock-import": "npm run prisma:generate && tsc -p scripts/tsconfig.production-stock-import.json --noEmit",
    "acceptance:mobile-auth": "tsx scripts/mobile-auth-regression-gate.ts",
    "acceptance:mobile-operations": "tsx scripts/mobile-operational-regression-gate.ts",
    "acceptance:mobile": "npm --workspace @flash-erp/mobile run typecheck && npm run acceptance:mobile-startup && npm run acceptance:mobile-auth && npm run acceptance:mobile-operations && npm run acceptance:mobile-ui",
    "acceptance:mobile:static": "npm run acceptance:mobile-startup -- --static-only && npm run acceptance:mobile-auth && npm run acceptance:mobile-operations",
    "acceptance:mobile-ui": "playwright test --config playwright.mobile.config.ts",
    "build:mobile:preview": "npm run acceptance:mobile && cd apps/mobile && npx eas-cli build -p android --profile preview"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "^7.7.0",
    "@prisma/client": "^7.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.2.2",
    "jsqr": "1.2.0",
    "prisma": "^7.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/engines@7.7.0": true,
    "electron@38.8.6": true,
    "esbuild@0.27.7": true,
    "node@24.16.0": true,
    "prisma@7.7.0": true,
    "sharp@0.34.5": true
  }
}
